{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": [
        "node_modules",
        ".git",
        "firebase-debug.log",
        "firebase-debug.*.log"
      ],
      "predeploy": [
        "npm --prefix \"$RESOURCE_DIR\" run build"
      ]
    }
  ],
  "hosting": {
    "site": "chef-privado",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "!**/.well-known/**",
      "**/node_modules/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "X-XSS-Protection",
            "value": "1; mode=block"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "/llms.txt",
        "headers": [
          {
            "key": "Content-Type",
            "value": "text/plain; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "regex": "^/(\\.well-known/)?ai-catalog\\.json$",
        "headers": [
          {
            "key": "Content-Type",
            "value": "application/json; charset=utf-8"
          },
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      },
      {
        "regex": "^/assets/[^/]+-[A-Za-z0-9_-]{8}\\.(js|css)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "regex": "^/(es(/.*)?|private-chef-punta-mita|private-chef-nuevo-nayarit|menu|galeria|experiencias|chef-franko|reservar|privacy)/?$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, max-age=0, must-revalidate"
          }
        ]
      },
      {
        "regex": "^/assets/[^/]+\\.(jpg|jpeg|png|webp|avif|gif|svg)$",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=3600"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/api/lead",
        "function": "apiLead"
      },
      {
        "source": "/api/assistant/chat",
        "function": "apiAssistantChat"
      },
      {
        "source": "/.well-known/ai-catalog.json",
        "destination": "/ai-catalog.json"
      },
      {
        "source": "/admin",
        "destination": "/admin/index.html"
      },
      {
        "source": "/admin/**",
        "destination": "/admin/index.html"
      },
      {
        "source": "/menu",
        "destination": "/menu/index.html"
      },
      {
        "source": "/galeria",
        "destination": "/galeria/index.html"
      },
      {
        "source": "/experiencias",
        "destination": "/experiencias/index.html"
      },
      {
        "source": "/chef-franko",
        "destination": "/chef-franko/index.html"
      },
      {
        "source": "/reservar",
        "destination": "/reservar/index.html"
      },
      {
        "source": "/privacy",
        "destination": "/privacy/index.html"
      },
      {
        "source": "/es",
        "destination": "/es/index.html"
      },
      {
        "source": "/private-chef-punta-mita",
        "destination": "/private-chef-punta-mita/index.html"
      },
      {
        "source": "/es/chef-privado-punta-mita",
        "destination": "/es/chef-privado-punta-mita/index.html"
      },
      {
        "source": "/private-chef-nuevo-nayarit",
        "destination": "/private-chef-nuevo-nayarit/index.html"
      },
      {
        "source": "/es/chef-privado-nuevo-nayarit",
        "destination": "/es/chef-privado-nuevo-nayarit/index.html"
      },
      {
        "source": "/es/experiencias",
        "destination": "/es/experiencias/index.html"
      },
      {
        "source": "/es/chef-franko",
        "destination": "/es/chef-franko/index.html"
      },
      {
        "source": "/es/galeria",
        "destination": "/es/galeria/index.html"
      },
      {
        "source": "/es/reservar",
        "destination": "/es/reservar/index.html"
      },
      {
        "source": "/es/menu",
        "destination": "/es/menu/index.html"
      },
      {
        "source": "/es/privacy",
        "destination": "/es/privacy/index.html"
      }
    ],
    "trailingSlash": true
  },
  "emulators": {
    "functions": {
      "port": 5001
    },
    "firestore": {
      "port": 8080
    },
    "ui": {
      "enabled": true,
      "port": 4000
    }
  }
}
