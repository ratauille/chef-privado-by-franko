rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Función auxiliar para verificar si el usuario tiene rol de administrador
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Colección: reservations (Acceso restringido. Toda reserva pública entra por /api/lead con Admin SDK)
    // Las reservas públicas se reciben por la Function apiLead, que escribe con Admin SDK.
    match /reservations/{reservationId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Colección: rate_limits (Solo modificada de forma segura por Firebase Admin SDK en backend)
    match /rate_limits/{docId} {
      allow read, write: if false;
    }

    // Colección: lead_idempotency (Solo modificada de forma segura por Firebase Admin SDK en backend)
    match /lead_idempotency/{docId} {
      allow read, write: if false;
    }

    // Colección: blockedDates (Fechas no disponibles sincronizadas con Google Calendar)
    match /blockedDates/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección: leads (Prospectos comerciales)
    match /leads/{leadId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    // Colección: mail (Utilizada por la extensión Trigger Email / Admin SDK)
    match /mail/{mailId} {
      allow create, read, update, delete: if isAdmin();
    }
  }
}
