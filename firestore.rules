rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Verificación estricta de Custom Claim Admin
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // Las reservas públicas se reciben por la Function apiLead, que escribe
    // con Admin SDK. El cliente web nunca debe escribir directamente aquí.
    match /reservations/{reservationId} {
      allow read, create, update, delete: if isAdmin();
    }

    // Colección: blockedDates (Fechas no disponibles sincronizadas con Google Calendar)
    match /blockedDates/{dateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección: services / menus (Catálogo de experiencias gastronómicas)
    match /services/{serviceId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Colección: mail (Utilizada por la extensión Trigger Email)
    match /mail/{mailId} {
      allow create, read, update, delete: if isAdmin();
    }
  }
}
